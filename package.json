{
  "name": "minuteminder-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:landing": "vite --mode landing",
    "dev:site": "vite --mode site",
    "build": "npm run prepare:deploy && vite build",
    "build:landing": "npm run prepare:deploy && vite build --mode landing",
    "build:site": "npm run prepare:deploy && vite build --mode site",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:landing": "vite preview --mode landing",
    "preview:site": "vite preview --mode site",
    "prepare:deploy": "node scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "clsx": "^2.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.9.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "vanilla-cookieconsent": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "vite": "^7.1.7"
  }
}
